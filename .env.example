# Copiar a .env.local y completar. Ver docs/DESPLIEGUE.md.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (sb_publishable_...), antes "anon"; va al navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (sb_secret_...), antes "service_role"; solo servidor, nunca al cliente ni al repo
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, con https:// y sin barra final. En local, http://localhost:3000.
# En Vercel solo en Production; en Preview dejarla sin definir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto del cron semanal (/api/cron/ping): openssl rand -hex 32
CRON_SECRET=

# Destinatario del mail de resultado
LIGA_EMAIL=ligasmunicipales@rivasciudad.es
